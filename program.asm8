; countdown.asm8
; Counts down from 15 to 0.
; Output should be:
; 15
; 14
; 13
; ...
; 0

COUNT EQU 0      ; data memory address 0 stores the current count
ONE   EQU 1      ; constant value 1

    LDI 15       ; rA <- 15
    STR COUNT    ; Mem[COUNT] <- rA

loop:
    LOD COUNT    ; rA <- Mem[COUNT]
    OUT          ; output current count

    JZ end       ; if zero flag is set, stop after printing 0

    LDI ONE      ; rA <- 1
    MOV rA rB   ; rB <- rA, so rB now stores 1

    LOD COUNT    ; rA <- current count again
    SUB rA rB   ; rB <- rA - rB, so rB becomes count - 1

    MOV rB rA   ; rA <- rB, so rA now stores the new count
    STR COUNT    ; Mem[COUNT] <- rA

    JMP loop     ; repeat

end:
    HLT